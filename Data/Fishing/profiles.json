  "biteProfiles": [
    {
      "id": "bite.probe",
      "pattern": "Probe",
      "description": "多次离散的小幅点动与停顿，真正下沉时才进入提竿窗口；核心是识别真假信号。"
    },
    {
      "id": "bite.strike",
      "pattern": "Strike",
      "description": "前摇很短，浮漂突然明显下沉，成功窗口较短；核心是及时反应。"
    },
    {
      "id": "bite.drag",
      "pattern": "Drag",
      "description": "试探阶段浮漂持续左右横移；真正咬钩时从当前位置斜向下沉并进入提竿窗口。核心是区分横移试探与斜向下沉信号。"
    }
  ],
