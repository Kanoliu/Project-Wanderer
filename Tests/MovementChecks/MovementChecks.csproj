<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Scripts/Fishing/FishMovementSettings.cs" Link="FishMovementSettings.cs" />
    <Compile Include="../../Scripts/Fishing/FishMovementSimulation.cs" Link="FishMovementSimulation.cs" />
    <Compile Include="../../Scripts/Fishing/Data/FishingDataModels.cs" Link="FishingDataModels.cs" />
    <Compile Include="../../Scripts/Fishing/Data/FishingDataRepository.cs" Link="FishingDataRepository.cs" />
    <Compile Include="../../Scripts/Fishing/Data/IFishingDataRepository.cs" Link="IFishingDataRepository.cs" />
    <Compile Include="../../Scripts/Core/FishingDepth.cs" Link="FishingDepth.cs" />
    <Compile Include="../../Scripts/Core/FishingSetup.cs" Link="FishingSetup.cs" />
    <Compile Include="../../Scripts/Core/DayPhase.cs" Link="DayPhase.cs" />
    <Compile Include="../../Scripts/Core/DialogueEffect*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../Scripts/Core/FishingOutcome.cs" Link="FishingOutcome.cs" />
    <Compile Include="../../Scripts/Core/FishingResult.cs" Link="FishingResult.cs" />
    <Compile Include="../../Scripts/Core/GameState.cs" Link="GameState.cs" />
    <Content Include="../../Data/Fishing/*.json" Link="Data/Fishing/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Data/Characters/characters.json" Link="Data/Characters/characters.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
